/* ==============================================================================
   JURIS_PULSE - HOJA DE ESTILOS NATIVA Y LOCAL (SISTEMA INTEGRADO)
   ============================================================================== */
body { 
    background-color: #020617; 
    color: #f8fafc; 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0; padding: 0; min-height: 100vh; display: flex; flex-direction: column; 
}
.contenedor-movil { max-width: 440px; margin: 0 auto; width: 100%; box-sizing: border-box; padding: 0 16px; }
header { background-color: rgba(15, 23, 42, 0.7); backdrop-filter: blur(8px); border-bottom: 1px solid #1e293b; padding: 12px 16px; position: sticky; top: 0; z-index: 40; }
.header-flex { display: flex; justify-content: space-between; align-items: center; max-width: 440px; margin: 0 auto; }
.logo { font-size: 20px; font-weight: 900; margin: 0; letter-spacing: 0.05em; }
.logo .pulse { color: #f59e0b; }
.grid-filtros { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
.selector-poda { background-color: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 12px; color: #cbd5e1; font-size: 12px; font-weight: bold; outline: none; width: 100%; box-sizing: border-box; }
.selector-poda:focus { border-color: #f59e0b; }
.caja-busqueda { position: relative; margin-top: 12px; width: 100%; box-sizing: border-box; }
.input-busqueda { width: 100%; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 12px 12px 12px 36px; color: #f8fafc; font-size: 12px; box-sizing: border-box; }
.input-busqueda:focus { border-color: #f59e0b; outline: none; }
.icono-buscar { position: absolute; left: 12px; top: 15px; color: #64748b; font-size: 12px; }
.dashboard-telemetria { background-color: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 16px; padding: 12px; margin-top: 12px; }
.telemetria-titulo { display: flex; justify-content: space-between; font-size: 11px; font-weight: bold; color: #94a3b8; }
.grid-relojes { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 8px; }
.reloj { background-color: rgba(2, 6, 23, 0.6); border: 1px solid #0f172a; padding: 8px; border-radius: 8px; text-align: center; }
.reloj-label { font-size: 9px; color: #64748b; font-weight: bold; text-transform: uppercase; margin: 0; }
.reloj-valor { font-size: 16px; font-weight: 900; margin: 4px 0 0 0; }
.reloj-valor.oro { color: #f59e0b; }
.ventana-scroll-local { max-height: 440px; overflow-y: auto; margin-top: 12px; display: flex; flex-direction: column; gap: 8px; padding-right: 4px; }
.tarjeta-tesis { background-color: #0f172a; border: 1px solid #1e293b; border-radius: 14px; padding: 12px; cursor: pointer; transition: all 0.2s; box-sizing: border-box; }
.tarjeta-tesis:hover { border-color: rgba(245, 158, 11, 0.4); }
.jurisprudencia-borde { border-left: 4px solid #f59e0b; }
.aislada-borde { border-left: 4px solid #475569; }
.meta-linea { display: flex; justify-content: space-between; font-size: 10px; font-weight: bold; color: #64748b; margin-bottom: 6px; }
.materia-badge { background-color: #020617; color: #94a3b8; padding: 2px 6px; border-radius: 4px; font-family: monospace; }
.tipo-badge.oro { color: #f59e0b; }
.rubro-titulo { font-size: 12px; font-weight: bold; color: #e2e8f0; line-height: 1.4; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.cortina-fondo { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(2, 6, 23, 0.9); backdrop-filter: blur(8px); z-index: 50; display: flex; flex-direction: column; justify-content: flex-end; }
.cortina-contenido { background-color: #0f172a; border-top: 1px solid #1e293b; border-radius: 16px 16px 0 0; max-width: 440px; margin: 0 auto; width: 100%; box-sizing: border-box; padding: 16px; max-height: 80vh; display: flex; flex-direction: column; box-shadow: 0 -10px 25px -5px rgba(0,0,0,0.5); }
.tirador { width: 48px; height: 6px; background-color: #1e293b; border-radius: 9999px; margin: 0 auto 12px auto; }
.oculto { display: none !important; }
.scroll-detalle { overflow-y: auto; flex: 1; padding-right: 4px; }
.detalle-header { border-bottom: 1px solid #1e293b; padding-bottom: 12px; margin-bottom: 12px; }
.detalle-rubro { font-size: 14px; font-weight: 900; color: #f8fafc; line-height: 1.4; margin: 8px 0 4px 0; }
.texto-ley-real { font-size: 12px; color: #cbd5e1; font-family: monospace; background-color: #020617; padding: 14px; border-radius: 12px; border: 1px solid #1e293b; line-height: 1.6; white-space: pre-line; }
.btn { flex: 1; padding: 12px; border-radius: 10px; font-size: 12px; font-weight: bold; cursor: pointer; border: none; transition: background 0.2s; }
.btn-cerrar { background-color: #1e293b; color: #cbd5e1; }
.btn-cerrar:hover { background-color: #334155; }
.btn-copiar { background-color: #d97706; color: #020617; font-weight: 900; }
.btn-copiar:hover { background-color: #f59e0b; }
footer { border-top: 1px solid #0f172a; text-align: center; padding: 12px 0; font-size: 9px; color: #475569; }